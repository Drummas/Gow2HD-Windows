#include <winres.h>

// Build.cmd writes these two files from LAUNCHER_VERSION in src/config.h before windres runs, so the exe reports
// the version it is actually built as. The manifest is the same as res/app.manifest, with the version filled in.
#include "launcher_version.h"

1 ICON "app.ico"
1 24 "launcher.manifest"

// Build scripts (zip) are added by build.cmd as SCRIPTS RCDATA through a generated scripts.rc.
#ifdef WITH_SCRIPTS
#include "scripts.rc"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LAUNCHER_VERSION_COMMA
 PRODUCTVERSION LAUNCHER_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sethlikepie"
            VALUE "FileDescription", "Gow2HD-Windows launcher (builds the port from your own copy)"
            VALUE "FileVersion", LAUNCHER_VERSION_STR
            VALUE "InternalName", "Gow2HD-Windows"
            VALUE "LegalCopyright", "MIT. Not affiliated with Sony Interactive Entertainment."
            VALUE "OriginalFilename", "Gow2HD-Windows.exe"
            VALUE "ProductName", "Gow2HD-Windows"
            VALUE "ProductVersion", LAUNCHER_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
